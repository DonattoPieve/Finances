{
  "name": "pluto",
  "version": "0.2.0",
  "description": "Pluto — app desktop de finanças pessoais",
  "main": "./out/main/index.js",
  "author": "Donatto Pieve",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "verificar": "npm run typecheck && npm run verificar:logica && npm run verificar:fiacao",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verificar:logica": "esbuild scripts/verificar-banco.ts --bundle --platform=node --format=esm --outfile=node_modules/.pluto-verificar.mjs --external:node:* --alias:electron=./scripts/stub-electron.ts --log-level=warning && node node_modules/.pluto-verificar.mjs",
    "verificar:fiacao": "node scripts/verificar-fiacao.mjs",
    "release": "npm run verificar && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Pluto"
}
